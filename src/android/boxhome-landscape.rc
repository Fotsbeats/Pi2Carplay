on property:sys.boot_completed=1
    start boxhome-landscape

on property:init.svc.aibox-handshake=stopped && property:sys.boot_completed=1
    start boxhome-landscape

service boxhome-landscape /system/bin/sh /system/bin/boxhome-landscape.sh
    class late_start
    user root
    group root system graphics
    seclabel u:r:su:s0
    disabled
    oneshot
